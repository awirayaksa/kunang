{
  "name": "kunang",
  "version": "0.1.1",
  "description": "Notepad-fast Markdown viewer/editor for Windows",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build; if ($?) { electron-builder }",
    "package:portable": "node scripts/build-portable.mjs",
    "release": "node scripts/release.mjs",
    "build:stub": "cd stub; go build -ldflags \"-s -w -H=windowsgui\" -o kunangstub.exe .",
    "gen:corpus": "node scripts/gen-corpus.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "tsx tests/unit/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "katex": "^0.18.2",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "morphdom": "^2.7.8"
  }
}
